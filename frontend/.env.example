# Copy to .env for local dev, and set the same variable in Vercel/Netlify's
# environment variable settings when you deploy.

# The URL of your deployed backend (Render/Railway/etc). No trailing slash.
VITE_API_URL=http://localhost:4000

# Cloudinary — needed so the browser can upload audio directly (unsigned upload).
# Both values are safe to expose in the frontend; they are not secrets.
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset-name

