# Copy this file to .env and fill in your own values. Never commit the real .env file.

# MongoDB Atlas connection string (free M0 cluster is enough).
# Get it from Atlas: Database > Connect > Drivers > copy the URI, then insert your DB user password.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/ziji?retryWrites=true&w=majority

# Any long random string — used to sign login sessions. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string

# The exact URL of your deployed frontend (Vercel/Netlify), so the backend only accepts requests from it.
# Use http://localhost:5173 while developing locally.
FRONTEND_URL=http://localhost:5173

PORT=4000

# --- Reverse-practice sentence correction (Gemini) ---
# Free API key from Google AI Studio: https://aistudio.google.com/apikey
# No credit card needed. Free tier: 250 requests/day on gemini-2.5-flash — plenty for this.
GEMINI_API_KEY=your-gemini-api-key

# --- Audio storage (Cloudinary) ---
# Free account: https://cloudinary.com/users/register/free
# Cloud name is shown on your Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=your-cloud-name
# Create an UNSIGNED upload preset (Settings > Upload > Upload presets > Add preset,
# set "Signing Mode" to Unsigned) — this preset name is also needed by the frontend.
# API key/secret are only used here, server-side, to delete clips when you remove them.
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

